{
  "name": "gjb-doc-platform-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=esm --outdir=dist-electron --external:electron --watch",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\" \"npm:electron:wait\"",
    "electron:wait": "wait-on tcp:5173 file:dist-electron/main.js && electron dist-electron/main.js",
    "build": "vue-tsc -b && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=esm --outdir=dist-electron --external:electron",
    "preview": "vite preview",
    "check": "vue-tsc -b",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.511.0",
    "tailwind-merge": "^3.3.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/runtime-dom": "^3.4.15",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.5",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.3.3",
    "unplugin-vue-dev-locator": "^1.0.0",
    "vite": "^5.0.12",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^1.8.27",
    "wait-on": "^8.0.3"
  },
  "buildConfig": {
    "appId": "mil.sandbox.gjb-doc-platform",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    }
  }
}
